# Application
APP_NAME=BharatTrade AI
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=true

# API
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# Local PostgreSQL
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/stock_ai

# Upstox read-only market-data token
# Never commit your real token.
UPSTOX_ANALYTICS_TOKEN=

# Model files
MODEL_DIRECTORY=ml_pipeline/artifacts
CONV1D_MODEL_PATH=ml_pipeline/artifacts/conv1d_model.onnx
LSTM_MODEL_PATH=ml_pipeline/artifacts/lstm_model.onnx
SCALER_PATH=ml_pipeline/artifacts/feature_scaler.joblib

# Paper trading
INITIAL_VIRTUAL_CAPITAL=100000
MAX_POSITION_PERCENT=10
DAILY_LOSS_LIMIT_PERCENT=3
DEFAULT_STOP_LOSS_PERCENT=2

# Logging
LOG_LEVEL=INFO